# Python cache files
__pycache__/
*.py[cod]

# Optional
*.so
*.egg-info/
.build/
build/
dist/
.coverage

# Virtualenvs
venv/

# Local scratch: saved embeddings/checkpoints and ad-hoc scripts
models/
saved_models/
test/

# Sphinx build output
docs/_build/

# Experiments output
experiments/results/

# Downloaded dataset caches (OpenFlights, torch_geometric Airports, etc.)
/data/

# Downloaded datasets under experiments/data/ (OGB, Planetoid, ...); the
# vendored single-cell CSVs are the exception and stay tracked.
experiments/data/*
!experiments/data/single_cell/
